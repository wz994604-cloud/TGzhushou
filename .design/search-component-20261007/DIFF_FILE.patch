diff --git a/src/style.css b/src/style.css
index 77acdc8..63ff2ca 100644
--- a/src/style.css
+++ b/src/style.css
@@ -3137,3 +3137,84 @@ html[data-surface=web] .primary { background:linear-gradient(135deg,#2192ff,#177
   html[data-surface=web] .publisher-switch { max-width:38%; }
   html[data-surface=web] .topbar-actions { display:none; }
 }
+
+/* Desktop top search: one focused neon search surface; the chat-list search remains contextual. */
+html[data-surface=web] .workspace-search {
+  position:relative;
+  display:flex;
+  align-items:center;
+  gap:10px;
+  width:min(390px,34vw);
+  min-width:220px;
+  max-width:390px;
+  min-height:42px;
+  height:42px;
+  padding:0 8px 0 13px;
+  overflow:hidden;
+  border:1px solid rgba(113,91,206,.72);
+  border-radius:14px;
+  background:linear-gradient(110deg,rgba(36,18,57,.97),rgba(11,13,28,.98) 56%,rgba(18,28,75,.98))!important;
+  box-shadow:0 0 0 1px rgba(255,255,255,.08) inset,0 0 16px rgba(235,75,186,.36),0 0 18px rgba(69,102,255,.28);
+}
+html[data-surface=web] .workspace-search::before,
+html[data-surface=web] .workspace-search::after {
+  content:"";
+  position:absolute;
+  top:50%;
+  width:58px;
+  height:58px;
+  transform:translateY(-50%);
+  border-radius:50%;
+  filter:blur(18px);
+  opacity:.46;
+  pointer-events:none;
+}
+html[data-surface=web] .workspace-search::before { left:-26px;background:rgba(238,70,183,.78); }
+html[data-surface=web] .workspace-search::after { right:-25px;background:rgba(71,102,255,.82); }
+html[data-surface=web] .workspace-search-glow {
+  position:absolute;
+  inset:1px;
+  border-radius:13px;
+  background:linear-gradient(90deg,rgba(255,87,199,.16),transparent 42%,rgba(79,107,255,.2));
+  pointer-events:none;
+}
+html[data-surface=web] .workspace-search-icon,
+html[data-surface=web] .workspace-search-filter,
+html[data-surface=web] .workspace-search input { position:relative;z-index:1; }
+html[data-surface=web] .workspace-search-icon { display:grid;place-items:center;flex:0 0 22px;color:#c8c3dc; }
+html[data-surface=web] .workspace-search-icon svg { width:21px;color:currentColor; }
+html[data-surface=web] .workspace-search input {
+  flex:1;
+  min-width:0;
+  min-height:38px;
+  height:38px;
+  margin:0;
+  padding:0;
+  border:0!important;
+  outline:0;
+  color:#f7f4ff;
+  background:transparent!important;
+  box-shadow:none!important;
+  font-size:14px;
+}
+html[data-surface=web] .workspace-search input::placeholder { color:#c3bfd0;opacity:1; }
+html[data-surface=web] .workspace-search input:focus-visible { outline:0; }
+html[data-surface=web] .workspace-search-filter {
+  display:grid;
+  place-items:center;
+  flex:0 0 38px;
+  width:38px;
+  height:38px;
+  padding:0;
+  border:1px solid rgba(174,166,239,.32);
+  border-radius:11px;
+  color:#d8d7ed;
+  background:linear-gradient(145deg,rgba(35,34,72,.96),rgba(11,12,28,.96));
+  box-shadow:0 0 0 1px rgba(255,255,255,.08) inset,0 4px 10px rgba(0,0,0,.28);
+  opacity:1;
+}
+html[data-surface=web] .workspace-search-filter svg { width:20px;height:20px; }
+html[data-surface=web] .workspace-search-filter:disabled { cursor:not-allowed;opacity:.92; }
+@media (max-width:599px) {
+  html[data-surface=web] .workspace-search { width:auto;min-width:0;max-width:none; }
+}
