{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "飞机助手",
  "version": "0.1.0",
  "identifier": "com.feijizhushou.internal",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "飞机助手",
        "url": "https://tgzhushou-production-c196.up.railway.app",
        "width": 1024,
        "height": 720,
        "minWidth": 860,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "飞机助手"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    },
    "createUpdaterArtifacts": false
  }
}
