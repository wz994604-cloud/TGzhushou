+/* Second-round interaction corrections: bounded mobile workspace and explicit
+   scroll ownership. These overrides preserve the existing DOM and behavior. */
+#workspace:has(#chat:not([hidden])){min-height:100dvh;height:100dvh;overflow:hidden}
+#workspace:has(#chat:not([hidden])) .chat-list,
+#workspace:has(#chat:not([hidden])) .chat-main{min-height:0;overflow:hidden}
+#workspace:has(#chat:not([hidden])) .chat-list{overflow-y:auto;overscroll-behavior:contain}
+#workspace:has(#chat:not([hidden])) .chat-main{display:flex;flex-direction:column}
+#workspace:has(#chat:not([hidden])) .chat-messages{min-height:0;flex:1 1 auto;overflow-y:auto;overscroll-behavior:contain}
+#workspace:has(#chat:not([hidden])) #chatComposer{position:static;flex:0 0 auto;max-height:min(34dvh,310px);overflow-y:auto;overscroll-behavior:contain}
+body:has(#workspace:not([hidden])){overflow:hidden}
+#settings .card{position:relative}
+#settings #token,#settings #ffaToken{background:#fffaf0;border-color:#f0d6a0}
+#settings #token:focus,#settings #ffaToken:focus{border-color:#e0a52b;box-shadow:0 0 0 3px rgb(224 165 43 / .18)}
+#settings #browserLogout{color:#b42318;background:#fff1f0;border:1px solid #f3c4c0}
+#settings .hint{max-width:72ch}
+#settings #ffaStatus:not(:empty),#settings #saveStatus:not(:empty),#settings #publisherStatus:not(:empty){padding:8px 10px;border-radius:8px;background:#f1f5f7}
+#settings .is-loaded,#settings #ffaStatus.is-loaded{background:#e8f7ee;color:#167447}
+#settings .error,#settings .status.FAILED{background:#fff1f0;color:#b42318}
+#players #playerList,#players #selectedPlayerList,#tasks #taskList,#chatConversations{min-height:42px}
+#inboxStatus{padding:6px 8px;border-radius:8px}
+@media(max-width:700px){
