+
+const port = Number(process.env.PORT || 8080);
+const server = app.listen(port, '0.0.0.0', async () => {
+  console.log(`TGzhushou listening on ${port}`);
+  scheduler.start();
+  const base = String(process.env.PUBLIC_URL || '').replace(/\/$/, '');
