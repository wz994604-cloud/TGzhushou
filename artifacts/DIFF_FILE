+  } catch (error) { console.error('Entry bot setup:', safeTelegramError(error)); }
+});
+function shutdown() { scheduler.stop(); server.close(() => { db.close(); process.exit(0); }); setTimeout(() => process.exit(0), 25000).unref(); }
